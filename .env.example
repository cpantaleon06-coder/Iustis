# Copia este archivo como .env y llena los valores. .env nunca se sube al repositorio.

# Modelo de lenguaje: groq (por defecto, tiene plan gratuito) o anthropic
LLM_PROVEEDOR=groq

# Groq (triaje, respuesta y notas de voz)
GROQ_API_KEY=
GROQ_MODELO_TRIAJE=openai/gpt-oss-20b
GROQ_MODELO_RESPUESTA=openai/gpt-oss-120b
GROQ_MODELO_WHISPER=whisper-large-v3-turbo
# Caracteres máximos de cada artículo que ve el modelo (el plan gratuito limita tokens por minuto)
MAX_CARACTERES_ARTICULO=3000

# Opcional: Claude (solo si LLM_PROVEEDOR=anthropic)
ANTHROPIC_API_KEY=
MODELO_TRIAJE=claude-haiku-4-5
MODELO_RESPUESTA=claude-sonnet-5
ESFUERZO_RESPUESTA=medium

# Opcional: Voyage AI (solo si rag/config.yaml usa proveedor: voyage; por defecto los embeddings son locales)
VOYAGE_API_KEY=

# WhatsApp (OpenWA, https://www.open-wa.org)
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# Secreto HMAC con el que se registró el webhook (obligatorio: sin él se rechazan los webhooks)
OPENWA_WEBHOOK_SECRET=

# Límites de uso (mensajes por hora). Protegen la cuota si el chat se expone con ngrok.
LIMITE_MENSAJES_USUARIO_HORA=20
LIMITE_MENSAJES_IP_HORA=60
