# Copia este archivo como .env y llena los valores.

# LLM (Claude)
ANTHROPIC_API_KEY=
MODELO_TRIAJE=claude-haiku-4-5
MODELO_RESPUESTA=claude-sonnet-5
ESFUERZO_RESPUESTA=medium

# Embeddings (Voyage AI)
VOYAGE_API_KEY=

# Notas de voz (Groq Whisper)
GROQ_API_KEY=
GROQ_MODELO_WHISPER=whisper-large-v3-turbo

# WhatsApp (OpenWA, https://www.open-wa.org)
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# Secreto HMAC con el que se registró el webhook (obligatorio: sin él se rechazan los webhooks)
OPENWA_WEBHOOK_SECRET=
